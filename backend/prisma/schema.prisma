generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(MODERATOR)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @db.VarChar(255)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(20)
  name      String
  semesters Semester[]

  @@map("departments")
}

model Semester {
  id             Int        @id @default(autoincrement())
  departmentId   Int
  semesterNumber Int
  name           String
  description    String?    @db.Text
  bgColor        String?    @db.VarChar(50)
  pinColor       String?    @db.VarChar(50)
  rotate         String?    @db.VarChar(20)
  sortOrder      Int        @default(0)
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects       Subject[]

  @@index([departmentId])
  @@map("semesters")
}

model Subject {
  id          String     @id @default(uuid())
  semesterId  Int
  code        String     @unique @db.VarChar(30)
  title       String
  shortForm   String?    @db.VarChar(100)
  description String?    @db.Text
  bgColor     String?    @db.VarChar(50)
  pinColor    String?    @db.VarChar(50)
  rotate      String?    @db.VarChar(20)
  icon        String?    @db.VarChar(50)
  cardType    String?    @db.VarChar(30)
  path        String?    @db.VarChar(100)
  sortOrder   Int        @default(0)
  resources   Resource[]
  semester    Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@map("subjects")
}

model Resource {
  id           String   @id @default(uuid())
  subjectId    String
  title        String
  description  String?  @db.Text
  resourceType String   @db.VarChar(50)
  fileUrl      String?  @db.VarChar(500)
  fileKey      String?  @db.VarChar(300)
  driveFileId  String?  @db.VarChar(300)
  webViewLink  String?  @db.VarChar(500)
  fileSize     Int?
  mimeType     String?  @db.VarChar(100)
  source       String?  @db.VarChar(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([isActive])
  @@map("resources")
}

model Opportunity {
  id          String   @id @default(uuid())
  seedKey     String?  @unique @db.VarChar(100) // stable slug for idempotent seeding
  title       String
  description String?  @db.Text
  category    String?  @db.VarChar(50)
  tag         String?  @db.VarChar(50)
  pinBg       String?  @db.VarChar(50)
  link        String?  @db.VarChar(500)
  deadline    String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("opportunities")
}

model Announcement {
  id        String    @id @default(uuid())
  seedKey   String?   @unique @db.VarChar(100) // stable slug for idempotent seeding
  text      String    @db.Text
  badge     String?   @db.VarChar(50)
  color     String?   @db.VarChar(50)
  deadline  DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@map("announcements")
}

model ResourceUpload {
  id           String           @id @default(uuid())
  subjectCode  String           @db.VarChar(30)
  resourceType String           @db.VarChar(50)
  title        String
  description  String?          @db.Text
  fileUrl      String?          @db.VarChar(500)
  fileKey      String?          @db.VarChar(300)
  driveFileId  String?          @db.VarChar(300)
  webViewLink  String?          @db.VarChar(500)
  mimeType     String?          @db.VarChar(100)
  status       SubmissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@map("resource_uploads")
}

model ResourceRequest {
  id           String           @id @default(uuid())
  subjectCode  String           @db.VarChar(30)
  resourceType String           @db.VarChar(50)
  description  String           @db.Text
  email        String           @db.VarChar(255)
  status       SubmissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@map("resource_requests")
}

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())

  @@map("subscribers")
}

model Poll {
  id              String       @id @default(uuid())
  title           String
  description     String?      @db.Text
  badgeLabel      String?      @default("Campus Referendum Box") @db.VarChar(100)
  statusTopDemand String?      @db.VarChar(100)
  statusVaultDrop String?      @db.VarChar(100)
  statusResolved  String?      @db.VarChar(100)
  options         PollOption[]
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([isActive])
  @@map("polls")
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String
  icon      String?  @default("description") @db.VarChar(50)
  votes     Int      @default(0)
  sortOrder Int      @default(0)
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@map("poll_options")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum Role {
  ADMIN
  MODERATOR
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
